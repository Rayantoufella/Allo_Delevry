{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": [
                "wsl.exe",
                "/usr/bin/php8.5",
                "/mnt/d/AlloDelevry/backend/artisan",
                "boost:mcp"
            ]
        },
        "jira" : {
            "type": "local",
            "enabled": true,
            "command": ["npx", "-y", "mcp-remote", "https://mcp.atlassian.com/v1/mcp/authv2"]
        },
        "chrome-devtools": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "chrome-devtools-mcp@latest"
            ],
            "enabled": true
        }
    }
}