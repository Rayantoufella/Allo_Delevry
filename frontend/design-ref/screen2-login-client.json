"<html><head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" data-dc-tpl=\"1\"><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\" data-dc-tpl=\"2\"></head>\n<body>\n<div id=\"dc-root\"><div class=\"sc-host\" data-sc-name=\"proto\"><div data-dc-tpl=\"5\" data-theme=\"dark\" style=\"min-height: 100vh; background: var(--bg); color: var(--fg); display: flex; flex-direction: column; transition: background 0.35s, color 0.35s;\">\n\n  \n  \n  <header data-dc-tpl=\"7\" style=\"position: sticky; top: 0px; z-index: 40; display: flex; align-items: center; gap: 18px; padding: 0px 22px; height: 64px; background: color-mix(in srgb,var(--bg) 82%,transparent); backdrop-filter: blur(18px); border-bottom: 1px solid var(--border);\">\n    <div data-dc-tpl=\"8\" style=\"display: flex; align-items: center; gap: 10px; cursor: pointer;\">\n      <div data-dc-tpl=\"9\" style=\"width: 32px; height: 32px; border-radius: 9px; background: var(--green); display: flex; align-items: center; justify-content: center; font-weight: 800; color: var(--green-ink); font-size: 18px;\">A</div>\n      <div data-dc-tpl=\"10\" style=\"font-weight: 800; font-size: 17px; letter-spacing: -0.02em;\">Allo<span data-dc-tpl=\"11\" style=\"color: var(--green);\">Delivery</span></div>\n    </div>\n    <div data-dc-tpl=\"12\" style=\"display: flex; gap: 4px; padding: 4px; background: var(--surface-2); border: 1px solid var(--border); border-radius: 12px; margin-left: 8px;\">\n      <button data-dc-tpl=\"13\" style=\"padding: 7px 14px; border-radius: 9px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; cursor: pointer; font-weight: 800; font-size: 13px; background: var(--surface); color: var(--fg);\">Espace client</button>\n      <button data-dc-tpl=\"14\" style=\"padding: 7px 14px; border-radius: 9px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; cursor: pointer; font-weight: 800; font-size: 13px; background: transparent; color: var(--fg-2);\">Espace livreur</button>\n    </div>\n    <div data-dc-tpl=\"15\" style=\"flex: 1 1 0%;\"></div>\n    \n    <button data-dc-tpl=\"19\" title=\"Thème\" style=\"width: 40px; height: 40px; border-radius: 11px; border: 1px solid var(--border); background: var(--surface); color: var(--fg); cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 17px;\"><span class=\"sc-interp\">☀</span></button>\n    <button data-dc-tpl=\"20\" title=\"Réinitialiser la démo\" style=\"width: 40px; height: 40px; border-radius: 11px; border: 1px solid var(--border); background: var(--surface); color: var(--fg-2); cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 16px;\">↺</button>\n  </header>\n  \n\n  \n  \n\n  \n  \n  <div data-dc-tpl=\"49\" style=\"flex: 1 1 0%; display: grid; grid-template-columns: 1.05fr 0.95fr;\">\n    <div data-dc-tpl=\"50\" style=\"position: relative; overflow: hidden; background: var(--green); color: var(--green-ink); padding: 56px; display: flex; flex-direction: column; justify-content: space-between;\">\n      <div data-dc-tpl=\"51\" style=\"font-weight: 800; font-size: 20px;\">Espace client</div>\n      <div data-dc-tpl=\"52\">\n        <div data-dc-tpl=\"53\" style=\"font-size: clamp(30px, 3.4vw, 46px); font-weight: 800; line-height: 1.05; letter-spacing: -0.03em;\">Demande. Suivi.<br data-dc-tpl=\"54\">Livré en confiance.</div>\n        <p data-dc-tpl=\"55\" style=\"max-width: 38ch; font-size: 16px; opacity: 0.82; line-height: 1.5; margin-top: 18px; font-weight: 600;\">Un lien, un QR code, et ton colis part. Suis le livreur sur la carte et discute en direct.</p>\n      </div>\n      <div data-dc-tpl=\"56\" style=\"display: flex; gap: 26px; font-weight: 700; font-size: 13px; opacity: 0.9;\"><div data-dc-tpl=\"57\">Suivi GPS live</div><div data-dc-tpl=\"58\">Chat privé</div><div data-dc-tpl=\"59\">Code de remise</div></div>\n      <div data-dc-tpl=\"60\" style=\"position: absolute; right: -60px; bottom: -40px; width: 280px; height: 280px; border: 40px solid rgba(255, 255, 255, 0.12); border-radius: 50%;\"></div>\n    </div>\n    <div data-dc-tpl=\"61\" style=\"display: flex; align-items: center; justify-content: center; padding: 40px; background: var(--bg);\">\n      <div data-dc-tpl=\"62\" class=\"au\" style=\"width: 100%; max-width: 380px;\">\n        <div data-dc-tpl=\"63\" style=\"font-size: 28px; font-weight: 800; letter-spacing: -0.02em;\"><span class=\"sc-interp\">Connexion client</span></div>\n        <div data-dc-tpl=\"64\" style=\"color: var(--fg-2); margin: 6px 0px 26px; font-weight: 500;\">Accède à tes demandes et au suivi de tes colis.</div>\n        \n        <label data-dc-tpl=\"68\" style=\"display: block; font-size: 12.5px; font-weight: 700; color: var(--fg-2); margin-bottom: 6px;\">Email</label>\n        <input data-dc-tpl=\"69\" placeholder=\"sara@email.com\" style=\"width: 100%; padding: 13px 15px; border-radius: 12px; border: 1px solid var(--border); background: var(--surface); color: var(--fg); font-size: 15px; margin-bottom: 16px;\">\n        <label data-dc-tpl=\"70\" style=\"display: block; font-size: 12.5px; font-weight: 700; color: var(--fg-2); margin-bottom: 6px;\">Mot de passe</label>\n        <input data-dc-tpl=\"71\" type=\"password\" value=\"demo1234\" style=\"width: 100%; padding: 13px 15px; border-radius: 12px; border: 1px solid var(--border); background: var(--surface); color: var(--fg); font-size: 15px; margin-bottom: 22px;\">\n        <button data-dc-tpl=\"72\" style=\"width: 100%; padding: 15px; border-radius: 13px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; background: var(--green); color: var(--green-ink); font-weight: 800; font-size: 15.5px; cursor: pointer;\"><span class=\"sc-interp\">Se connecter</span></button>\n        <div data-dc-tpl=\"73\" style=\"text-align: center; color: var(--fg-2); font-size: 14px; margin-top: 20px;\"><span class=\"sc-interp\">Pas encore de compte ?</span> <span data-dc-tpl=\"74\" style=\"color: var(--green); font-weight: 800; cursor: pointer;\"><span class=\"sc-interp\">Créer un compte</span></span></div>\n      </div>\n    </div>\n  </div>\n  \n\n  \n  \n\n  \n  \n\n  \n  \n\n  \n  \n\n  \n  \n\n  \n  </div></div></div>\n\n\n\n\n\n</body></html>"