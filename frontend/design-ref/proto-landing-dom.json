adow:0 24px 60px -24px rgba(20,40,25,.22);\n    --blue:#2f6fe0;--amber:#c98a12;--violet:#7a56d6;--red:#e0483d;\n  }\n  @keyframes spin{to{transform:rotate(360deg)}}\n  @keyframes pulse{0%{box-shadow:0 0 0 0 rgba(34,197,111,.55)}70%{box-shadow:0 0 0 16px rgba(34,197,111,0)}100%{box-shadow:0 0 0 0 rgba(34,197,111,0)}}\n  @keyframes fadeUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}\n  @keyframes floaty{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}\n  @keyframes sweep{0%{transform:translateY(-120%)}100%{transform:translateY(320%)}}\n  @keyframes toastIn{from{opacity:0;transform:transl(0,20px) translateX(-50%)}to{opacity:1;transform:translateX(-50%)}}\n  .au{animation:fadeUp .5s cubic-bezier(.2,.7,.3,1) both}\n</style></head>\n<body>\n<div id=\"dc-root\"><div class=\"sc-host\" data-sc-name=\"proto\"><div data-dc-tpl=\"5\" data-theme=\"dark\" style=\"min-height: 100vh; background: var(--bg); color: var(--fg); display: flex; flex-direction: column; transition: background 0.35s, color 0.35s;\">\n\n  \n  \n\n  \n  \n  <div data-dc-tpl=\"22\" style=\"flex: 1 1 0%; position: relative; overflow: hidden; display: flex; flex-direction: column;\">\n    <div data-dc-tpl=\"23\" style=\"position: absolute; inset: 0px; background: radial-gradient(900px 500px at 80% -10%,color-mix(in srgb,var(--green) 26%,transparent),transparent 60%),radial-gradient(700px 500px at 5% 110%,color-mix(in srgb,var(--green) 14%,transparent),transparent 55%);\"></div>\n    <header data-dc-tpl=\"24\" style=\"position: relative; display: flex; align-items: center; gap: 12px; padding: 26px 40px;\">\n      <div data-dc-tpl=\"25\" style=\"width: 38px; height: 38px; border-radius: 11px; background: var(--green); display: flex; align-items: center; justify-content: center; font-weight: 800; color: var(--green-ink); font-size: 22px;\">A</div>\n      <div data-dc-tpl=\"26\" style=\"font-weight: 800; font-size: 20px; letter-spacing: -0.02em;\">Allo<span data-dc-tpl=\"27\" style=\"color: var(--green);\">Delivery</span></div>\n      <div data-dc-tpl=\"28\" style=\"flex: 1 1 0%;\"></div>\n      <button data-dc-tpl=\"29\" style=\"width: 42px; height: 42px; border-radius: 12px; border: 1px solid var(--border); background: var(--surface); color: var(--fg); cursor: pointer; font-size: 18px;\"><span class=\"sc-interp\">☀</span></button>\n    </header>\n    <div data-dc-tpl=\"30\" style=\"position: relative; flex: 1 1 0%; display: flex; flex-direction: column; justify-content: center; padding: 20px 40px 60px; max-width: 1200px; margin: 0px auto; width: 100%;\">\n      <div data-dc-tpl=\"31\" class=\"au\" style=\"display: inline-flex; align-items: center; gap: 9px; align-self: flex-start; padding: 7px 14px; border-radius: 30px; background: var(--surface); border: 1px solid var(--border); font-size: 12.5px; font-weight: 700; color: var(--fg-2); margin-bottom: 22px;\">\n        <span data-dc-tpl=\"32\" style=\"width: 7px; height: 7px; border-radius: 50%; background: var(--green); animation: 2s ease 0s infinite normal none running pulse;\"></span>Plateforme de livraison entre clients &amp; livreurs-entrepreneurs\n      </div>\n      <h1 data-dc-tpl=\"33\" class=\"au\" style=\"margin: 0px; font-size: clamp(40px, 6vw, 74px); font-weight: 800; line-height: 0.98; letter-spacing: -0.035em; max-width: 16ch;\">Chaque livreur, sa <span data-dc-tpl=\"34\" style=\"color: var(--green);\">marque</span>. Chaque colis, un <span data-dc-tpl=\"35\" style=\"color: var(--green);\">suivi</span>.</h1>\n      <p data-dc-tpl=\"36\" class=\"au\" style=\"max-width: 60ch; font-size: clamp(16px, 1.6vw, 20px); color: var(--fg-2); line-height: 1.5; margin: 22px 0px 42px; font-weight: 500;\">Demande assistée par IA, acceptation &amp; tarif par le livreur, suivi GPS en direct, chat privé, code de remise sécurisé et preuve de livraison — le workflow complet, sans intermédiaire.</p>\n      <div data-dc-tpl=\"37\" style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 22px; max-width: 900px;\">\n        <div data-dc-tpl=\"38\" class=\"au scp0\" style=\"cursor: pointer; position: relative; overflow: hidden; padding: 30px; border-radius: 22px; background: var(--surface); border: 1px solid var(--border); box-shadow: var(--shadow); transition: transform 0.25s, border-color 0.25s;\">\n          <div data-dc-tpl=\"39\" style=\"width: 52px; height: 52px; border-radius: 15px; background: color-mix(in srgb,var(--green) 16%,transparent); display: flex; align-items: center; justify-content: center; color: var(--green); margin-bottom: 18px;\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8z\"></path><path d=\"M4 21a8 8 0 0 1 16 0\"></path></svg></div>\n          <div data-dc-tpl=\"40\" style=\"font-size: 22px; font-weight: 800; letter-spacing: -0.02em;\">Je suis client</div>\n          <div data-dc-tpl=\"41\" style=\"color: var(--fg-2); font-size: 14.5px; margin: 8px 0px 20px; line-height: 1.5;\">Ouvre la page d'un livreur, décris ta demande à l'IA ou choisis un service, puis suis ton colis en direct.</div>\n          <div data-dc-tpl=\"42\" style=\"display: flex; align-items: center; gap: 8px; color: var(--green); font-weight: 800; font-size: 14px;\">Demander une livraison →</div>\n        </div>\n        <div data-dc-tpl=\"43\" class=\"au scp1\" style=\"cursor: pointer; position: relative; overflow: hidden; padding: 30px; border-radius: 22px; background: var(--fg); color: var(--bg); border: 1px solid var(--fg); box-shadow: var(--shadow); transition: transform 0.25s;\">\n          <div data-dc-tpl=\"44\" style=\"width: 52px; height: 52px; border-radius: 15px; background: var(--green); display: flex; align-items: center; justify-content: center; color: var(--green-ink); margin-bottom: 18px;\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M13 2 4 14h7l-1 8 9-12h-7z\"></path></svg></div>\n          <div data-dc-tpl=\"45\" style=\"font-size: 22px; font-weight: 800; letter-spacing: -0.02em;\">Je suis livreur-entrepreneur</div>\n          <div data-dc-tpl=\"46\" style=\"opacity: 0.7; font-size: 14.5px; margin: 8px 0px 20px; line-height: 1.5;\">Ta marque, ton catalogue, tes zones &amp; tarifs, tes missions et tes revenus dans un tableau de bord.</div>\n          <div data-dc-tpl=\"47\" style=\"display: flex; align-items: center; gap: 8px; color: var(--green); font-weight: 800; font-size: 14px;\">Ouvrir mon espace →</div>\n        </div>\n      </div>\n    </div>\n  </div>\n  \n\n  \n  \n\n  \n  \n\n  \n  \n\n  \n  \n\n  \n  \n\n  \n  \n\n  \n  </div></div></div>\n<script type=\"text/x-dc\" data-dc-script=\"\" data-props=\"{&quot;$preview&quot;:{&quot;width&quot;:&quot;100%&quot;,&quot;height&quot;:&quot;100%&quot;}}\">\nclass Component extends DCLogic {\n  SERVICES = [\n    { id:'colis', name:'Envoi de colis', desc:'Petit à moyen colis, main propre', base:15, icon:'box' },\n    { id:'doc', name:'Documents & plis', desc:'Papiers, contrats, plis urgents', base:12, icon:'doc' },\n    { id:'courses', name:'Courses & achats', desc:'Achat puis livraison', base:20, icon:'cart' },\n    { id:'repas', name:'Plats & repas', desc:'Récupération et livraison de repas', base:18, icon:'food' },\n    { id:'pharma', name:'Pharmacie', desc:'Médicaments et parapharmacie', base:14, icon:'pill' },\n  ];\n  ZONES = [\n    { id:'z1', name:'Centre-ville', fee:15, color:'#22c56f', count:312 },\n    { id:'z2', name:'Al Houda', fee:20, color:'#5b9dff', count:198 },\n    { id:'z3', name:'Hay Mohammadi', fee:25, color:'#a98bff', count:141 },\n    { id:'z4', name:'Périphérie', fee:35, color:'#f5b544', count:87 },\n  ];\n  PAYMENTS = [\n    { id:'cash', label:'Espèces à la livraison', emoji:'💵' },\n    { id:'rib', label:'Virement bancaire par RIB', emoji:'🏦' },\n  ];\n  RIB = { titulaire:'Rayan Express SARL', banque:'CIH Bank', iban:'MA64 0230 0000 1234 5678 9012 34' };\n  ATT_LABELS = { colis:'Photo du colis', ticket:'Reçu / commande', rib:'Preuve de virement', remise:'Preuve de remise', incident:'Photo incident', photo:'Photo' };\n  STATUS = {\n    en_attente:{label:'En attente', step:0, color:'var(--amber)'},\n    prix_propose:{label:'Prix proposé', step:1, color:'var(--blue)'},\n    confirmee:{label:'Confirmée', step:2, color:'var(--blue)'},\n    colis_recupere:{label:'Colis récupéré', step:3, color:'var(--violet)'},\n    en_livraison:{label:'En livraison', step:4, color:'var(--green)'},\n    livree:{label:'Livrée', step:5, color:'var(--green)'},\n    refusee:{label:'Refusée', step:-1, color:'var(--red)'},\n    incident:{label:'Incident', step:-1, color:'var(--amber)'},\n    echec:{label:'Échec', step:-1, color:'var(--red)'},\n    annulee:{label:'Annulée', step:-1, color:'var(--fg-3)'},\n  };\n  STEPS = [\n    {key:'confirmee', label:'Demande confirmée'},\n    {key:'colis_recupere', label:'Colis récupéré'},\n    {key:'en_livraison', label:'En route vers vous'},\n    {key:'approach', label:'Arrivée imminente'},\n    {key:'livree', label:'Colis livré'},\n  ];\n  ROUTE = [[14,84],[30,72],[44,60],[60,44],[76,30],[88,16]];\n\n  state = {\n    theme:'dark', space:'landing',\n    clientAuthed:false, driverAuthed:false, clientAuthMode:'login', driverAuthMode:'login',\n    clientRoute:'public', driverRoute:'dashboard',\n    describeText:'', aiLoading:false, aiError:'', aiConfidence:null, fromAI:false,\n    form:{ serviceType:'', recipientName:'', recipientPhone:'', deliveryAddress:'', pickupAddress:'', packageDescription:'', productAmount:'', scheduledAt:'', zoneId:'z2', paymentMethod:'cash' },\n    fillMode:'manual', zones:null, marker:null, delivery:null, chat:[],\n    proofName:'', enteredCode:'', codeError:'', codeAttempts:0, photoTaken:false, photoPackage:null, photoId:null, deliveryProof:n