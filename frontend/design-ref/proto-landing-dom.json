oDriver=()=>this.setState({space:'driver'});\n  clientLogin=()=>this.setState({clientAuthed:true, clientRoute:'public'});\n  driverLogin=()=>this.setState({driverAuthed:true, driverRoute:'dashboard'});\n  toggleClientAuth=()=>this.setState(s=>({clientAuthMode:s.clientAuthMode==='login'?'signup':'login'}));\n  toggleDriverAuth=()=>this.setState(s=>({driverAuthMode:s.driverAuthMode==='login'?'signup':'login'}));\n  goRequests=()=>this.setState({driverRoute:'requests'});\n  previewPublic=()=>this.setState({space:'client', clientAuthed:true, clientRoute:'public'});\n  openTracking=()=>{ if(this.state.delivery){ this.setState({space:'client', clientAuthed:true, clientRoute:'tracking'}); } };\n\n  // ---- client flow ----\n  startDescribe=()=>this.setState({clientRoute:'describe', aiError:''});\n  startCatalogue=()=>this.setState({clientRoute:'form', fromAI:false, fillMode:'manual'});\n  backToPublic=()=>this.setState({clientRoute:'public'});\n  onDescribeInput=e=>this.setState({describeText:e.target.value});\n  fillExample=()=>this.setState({describeText:'Livrer demain avant 15h à Sara, 06 12 34 56 78, quartier Al Houda Agadir. Colis : chaussures taille 39. Montant à encaisser : 420 DH. Retrait chez Rayan, Avenue Hassan II.'});\n\n  matchService(str){\n    const t=String(str||'').toLowerCase();\n    return this.SERVICES.find(s=>s.name.toLowerCase()===t)\n      || this.SERVICES.find(s=>t.includes(s.id))\n      || this.SERVICES.find(s=>t.split(/\\s|&|,/).some(w=>w&&s.name.toLowerCase().includes(w)))\n      || null;\n  }\n  // Extraction locale de secours (regex) — garantit un préremplissage même sans IA\n  localExtract(txt){\n    const low=txt.toLowerCase();\n    const phone=(txt.match(/(?:0|\\+212\\s?)[\\s\\d]{8,}/)||[])[0]||'';\n    const amount=(txt.match(/(\\d{2,5})\\s*(?:dh|dhs|dirham)/i)||[])[1]||'';\n    let name=''; const nm=txt.match(/(?:à|a|pour|chez)\\s+([A-ZÀ-Ý][\\wÀ-ÿ]+)/); if(nm)name=nm[1];\n    let sched=''; const sc=low.match(/(demain|aujourd|ce soir|matin|